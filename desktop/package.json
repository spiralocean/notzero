{
  "name": "bitcoin-lottery-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app (Electron) for the Bitcoin Lottery \u2014 wraps the dashboard and (in later phases) downloads/manages bitcoind + runs the miner, so non-technical users never touch a terminal.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:engines": "bash build-engines.sh",
    "dist": "npm run build:engines && electron-builder",
    "dist:mac": "npm run build:engines && electron-builder --mac dir"
  },
  "build": {
    "appId": "com.spiralocean.bitcoinlottery",
    "productName": "Bitcoin Lottery",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/icon.png",
      "wizard.html"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!node.json",
          "!*.map"
        ]
      },
      {
        "from": "resources",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.finance",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}