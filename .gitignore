# Build artifacts
**/build/
**/*.o
**/*.app
**/*.saver

# macOS
.DS_Store

# Local config / runtime state
config.json
data/
*.log

# Python
__pycache__/
*.pyc
.venv/

# Local runtime state (written by the node bridge)
/web/node.json

# dev tooling
node_modules/
test-results/
playwright-report/

# Electron packaged output
desktop/dist/
desktop/resources/

# local release credentials (never commit)
release.env
rclone.txt

# large local UTXO snapshot artifact (never commit)
scripts/utxo-snapshot-*.dat

# built installers / release artifacts — these go to R2 (dl.getnotzero.com), never git
*.exe
*.dmg
*.zip
*.AppImage
*.deb
*.blockmap
latest*.yml

# wrangler local state
.wrangler/
