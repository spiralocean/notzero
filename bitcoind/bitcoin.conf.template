# Bitcoin Lottery — optional Live mode (advanced users only)
# Practice mode works without Bitcoin Core. This config is only needed for Live mode.
# Copy to: ~/Library/Application Support/Bitcoin/bitcoin.conf (macOS)
#
# Disk use: ~15–18 GB total (UTXO set + ~2 GB pruned blocks) — NOT 600 GB
# Network: still downloads the chain once during initial sync; old blocks are
# discarded as they are validated, so free disk space stays small.

# --- Required for lottery miner RPC ---
server=1
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
# Generated by scripts/setup-bitcoind.sh:
# rpcuser=lottery
# rpcpassword=CHANGE_ME

# --- Space savers ---
# Keep only ~2 GB of recent blocks (minimum allowed is 550, but 2048 is safer)
prune=2048

# No local wallet — payout address is set in the lottery app config
disablewallet=1

# Don't relay/mempool-track txs — saves bandwidth and RAM; block reward still works
blocksonly=1

# --- Performance / bandwidth ---
dbcache=450
maxconnections=8

# Optional: put block data on an external drive (uncomment and edit path)
# blocksdir=/Volumes/YourDrive/bitcoin-blocks